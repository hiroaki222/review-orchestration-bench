# 個人的な下書き (メール文面等) — 公開 repo に含めない
drafts/

# ベンチマーク対象リポの clone 置き場 (repos/fetch.sh で再取得可能)
repos/*
!repos/fetch.sh

# LaTeX build artifacts (scoped to docs/paper/ to avoid catching run logs)
docs/paper/**/*.aux
docs/paper/**/*.log
docs/paper/**/*.nav
docs/paper/**/*.out
docs/paper/**/*.snm
docs/paper/**/*.toc
docs/paper/**/*.synctex.gz
docs/paper/**/*.fls
docs/paper/**/*.fdb_latexmk
docs/paper/**/*.dvi
docs/paper/**/*.bbl
docs/paper/**/*.blg

# JSAI style files (redistribution not permitted by JSAI)
docs/paper/jsai_5_0_1_template/
docs/paper/jsai_sig-1_0_0/

# author contact info (kept out of source, injected from PAPER_EMAIL env at build)
docs/paper/**/email.tex

# secrets / local env
.env

__pycache__/
